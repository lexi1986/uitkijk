[Unit]
Description=camera-service: SSH-tunnel naar Ollama op de AI-server (alleen loopback)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aitunnel
Group=aitunnel
# Lokaal 127.0.0.1:11435 -> op de AI-server 127.0.0.1:11434 (Ollama). De sleutel mag daar
# alleen naar die bestemming doorverbinden (restrict,port-forwarding,permitopen).
ExecStart=/usr/bin/ssh -N -T \
  -L 127.0.0.1:11435:127.0.0.1:11434 \
  -o BatchMode=yes \
  -o ExitOnForwardFailure=yes \
  -o ServerAliveInterval=30 \
  -o ServerAliveCountMax=3 \
  -o StrictHostKeyChecking=yes \
  -o UserKnownHostsFile=/var/lib/aitunnel/.ssh/known_hosts \
  -o IdentitiesOnly=yes \
  -i /var/lib/aitunnel/.ssh/id_ed25519 \
  gebruiker@ai-server
Restart=always
RestartSec=10

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadOnlyPaths=/var/lib/aitunnel

[Install]
WantedBy=multi-user.target
